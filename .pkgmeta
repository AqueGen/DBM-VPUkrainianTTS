package-as: DBM-VPUkrainianTTS

# Every voice is its own addon (DBM takes one voice per folder); all of them ship in this one download.
move-folders:
  DBM-VPUkrainianTTS/voices/DBM-VPUkrainianAlex: DBM-VPUkrainianAlex
  DBM-VPUkrainianTTS/voices/DBM-VPUkrainianEvgeniy: DBM-VPUkrainianEvgeniy
  DBM-VPUkrainianTTS/voices/DBM-VPUkrainianSolomiya: DBM-VPUkrainianSolomiya

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  # AGENTS.md is deliberately NOT ignored: the notice only does its job where
  # an agent actually reads the addon, which is the installed folder.
  - README.md
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - CLAUDE.md
  - .github
  - release-please-config.json
  - .release-please-manifest.json
  - generation
  - tests
  - assets
  - docs
  - .gitignore
